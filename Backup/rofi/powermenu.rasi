/****************************************************************
 * ROUNDED POWER MENU — TYPE-5, STYLE-2
 ****************************************************************/

* {
    font:   "JetBrainsMono Nerd Font 10";
    bg0:    #1e1e2eFF;
    bg1:    #313244FF;
    fg0:    #cdd6f4FF;
    accent: #89b4faFF;
    urgent: #f38ba8FF;
}

configuration {
    show-icons:         false;
    sleek-mode:         true;
    hover-select:       true;
    me-select-entry:    "MousePrimary";
    me-accept-entry:    "!MousePrimary";
}

window {
    transparency:       "real";
    location:           center;
    anchor:             center;
    fullscreen:         false;
    width:              750px;
    x-offset:           0px;
    y-offset:           0px;
    enabled:            true;
    margin:             0px;
    padding:            0px;
    border:             2px solid;
    border-color:       #59546d;
    border-radius:      16px;
    cursor:             "default";
    background-color:   @bg0;
    text-color:         @fg0;
}

mainbox {
    enabled:            true;
    spacing:            15px;
    margin:             0px;
    padding:            25px;
    background-color:   transparent;
    children:           [ "listview" ];
}

listview {
    enabled:            true;
    columns:            3;
    lines:              1;
    cycle:              true;
    dynamic:            true;
    scrollbar:          false;
    layout:             vertical;
    fixed-height:       true;
    fixed-columns:      true;
    spacing:            12px;
    margin:             0px;
    padding:            0px;
    background-color:   transparent;
    text-color:         @fg0;
    cursor:             "default";
}

element {
    enabled:            true;
    spacing:            8px;
    margin:             0px;
    padding:            15px 10px;
    border:             0px solid;
    border-radius:      12px;
    background-color:   @bg1;
    text-color:         @fg0;
    cursor:             pointer;
    orientation:        vertical;
}

element-text {
    enabled:            true;
    font:               "JetBrainsMono Nerd Font 11";
    background-color:   transparent;
    text-color:         inherit;
    cursor:             inherit;
    horizontal-align:   0.5;
    vertical-align:     0.5;
}

element selected.normal {
    background-color:   @accent;
    text-color:         #11111bFF;
}